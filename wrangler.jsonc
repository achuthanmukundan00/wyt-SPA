{
  "name": "watchyourtemper-api",
  "main": "watchyourtemper-site/src/worker.ts",
  "compatibility_date": "2026-04-14",
  "durable_objects": {
    "bindings": [
      {
        "name": "ORDER_STORE",
        "class_name": "OrderStoreDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OrderStoreDurableObject"]
    }
  ],
  "assets": {
    "directory": "./watchyourtemper-site/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1 // optional. default = 1.
  }
}