# Server-side only. Never expose this in browser code.
PRINTFUL_TOKEN=replace-with-printful-oauth-token
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRINTFUL_WEBHOOK_SECRET=
STORE_BASE_URL=http://localhost:5173
EMAIL_PROVIDER=resend
